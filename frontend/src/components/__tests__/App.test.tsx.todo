import { render, screen } from '@testing-library/react'

import { BrowserRouter } from 'react-router-dom'
import { vi } from 'vitest'
import App from '../App'

vi.mock('../channels/Channels')

// FIXME: Seems like vitest may be having some issues with testing the lit components

describe('App.tsx', () => {
  it('renders channels link', () => {
    // TODO: Add helper renderWithRouter function
    // https://testing-library.com/docs/example-react-router/#reducing-boilerplate
    render(
      <BrowserRouter>
        <App />
      </BrowserRouter>,
    )
    const linkElement = screen.getByText(/Channels/i)
    expect(linkElement).toBeInTheDocument()
  })
})
