{
    "env": {
        "node": true,
        "es2021": true,
        "jest/globals": true
    },
    "settings": {
        "import/extensions": [".mjs", ".js"],
        "import/resolver": {
            "node": {
                "extensions": [".mjs", ".js"]
            }
        }
    },
    "extends": [
        "plugin:prettier/recommended",
        "eslint:recommended"
    ],
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "plugins": ["prettier"],
    "rules": {
        "prettier/prettier": "error",
        "indent": [
            "warn",
            2
        ],
        "linebreak-style": [
            "warn",
            "unix"
        ],
        "max-len": [
            "warn",
            {
                "code": 80,
                "tabWidth": 2,
                "ignoreComments": true
            }
        ],
        "quotes": [
            "warn",
            "single"
        ],
        "semi": [
            "warn",
            "never"
        ]
    }
}
